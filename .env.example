# Скопируйте в .env и заполните значения:
#   cp .env.example .env

JARVIS_HOST=127.0.0.1
JARVIS_PORT=8787

# Telegram — кнопка «Отправить в ТГ текущий анализ»
# Токен бота: @BotFather → /newbot → строка вида 7123456789:AAH...
JARVIS_TELEGRAM_BOT_TOKEN=
# Id чата: напишите боту, затем откройте
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# и возьмите result[].message.chat.id (для группы часто отрицательный, напр. -100…)
JARVIS_TELEGRAM_CHAT_ID=
